# MA3 Bridge Local Configuration

# Bridge server port
PORT=3001

# Vercel app URL (change for production)
VERCEL_APP_URL=http://localhost:3000
# VERCEL_APP_URL=https://your-app.vercel.app

# MA3 OSC Configuration
MA3_HOST=127.0.0.1
MA3_PORT=8000

# Result Capture Settings
# Directory where result files are written (must be accessible by MA3)
# Default: System temp directory + /gma3_results
# RESULT_DIR=C:/Users/<username>/AppData/Local/Temp/gma3_results

# Script timeout in milliseconds
SCRIPT_TIMEOUT=30000

# Clean up temporary files after execution
CLEANUP_TEMP_FILES=true

# Optional: API secret for authentication
# When set, all requests (except /health) must include X-API-Secret header
# IMPORTANT: Set this when exposing bridge to internet via ngrok/tunnel!
# API_SECRET=your-secret-key-here
